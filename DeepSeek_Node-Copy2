from check import check

ComfyUI_tools_by_dong_path = os.path.dirname(os.path.abspath(__file__))
custom_node_path = os.path.dirname(ComfyUI_tools_by_dong_path)
ComfyUI_path = os.path.dirname(custom_node_path)
api_path = os.path.join(ComfyUI_path, "api_by_dong.yaml")

class DeepSeek_Node:

    def __init__(self):
        pass

    @classmethod
    def INPUT_TYPES(cls):
        return {
            "required": {
                "model": (["siliconflow", "nvidia", "aliyun"], {"default": "siliconflow"}),
                "system_prompt": ("STRING",),
                "user_prompt": ("STRING",),
            },
            "optional": {
                "siliconflow_model": (["DeepSeek-R1","DeepSeek-V3","DeepSeek-R1-Distill-Qwen-32B","DeepSeek-R1-Distill-Qwen-14B","free-DeepSeek-R1-0528-Qwen3-8B","free-DeepSeek-R1-Distill-Qwen-7B"], {"default":"DeepSeek-R1"}),
                "nvidia_model": (["DeepSeek-R1"], {"default": "DeepSeek-R1"}),
                "aliyun_model": (["DeepSeek-R1","DeepSeek-V3","free-DeepSeek-R1-Distill-Llama-70B","DeepSeek-R1-Distill-Qwen-32B","DeepSeek-R1-Distill-Qwen-14B","free-DeepSeek-R1-Distill-Llama-8B","DeepSeek-R1-Distill-Qwen-7B","free-DeepSeek-R1-Distill-Qwen-1.5B"], {"default":"DeepSeek-R1"}),
            }
        }
        
    RETURN_TYPES = ("BOOLEAN", "STRING",) 
    RETURN_NAMES = ("bool", "answer",) 
    FUNCTION = "LLM"
    CATEGORY = "dong_tools/DeepSeek_by_dong"  

    def LLM(self, model, system_prompt, user_prompt, siliconflow_model, nvidia_model, aliyun_model):
        if not check():
            print("未授权用户")
            return (False,)
    
        if not os.path.exists(api_path):
            print("api_key未设置")
            return (False, "api_key未设置，请使用set_api节点设置api")
    
        with open(api_path, 'r') as file:
            api_keys = yaml.safe_load(file)
            
        if system_prompt == "":
            system_prompt = "你是一个乐于解答各种问题的助手，你的任务是为用户提供专业、准确、有见地的建议。"            

        # 通用请求重试函数
        def request_with_retry(func, retries=3, delay=5):
            for i in range(retries):
                try:
                    return func()
                except Exception as e:
                    print(f"请求异常: {e}，第{i+1}次重试...")
                    time.sleep(delay)
            return None

        # SiliconFlow 调用
        def siliconflow():
            def call():
                api_key = api_keys['siliconflow']['api_key'] 
                url = "https://api.siliconflow.cn/v1/chat/completions"
                model_to_use = siliconflow_model.replace('free-', '')
                select_model = "deepseek-ai/" + model_to_use
                print("\n"+select_model)

                payload = {
                    "model": select_model,
                    "messages": [{"role": "system", "content": system_prompt},{"role": "user", "content": user_prompt}],
                    "stream": False,
                    "max_tokens": 8192,
                    "stop": ["null"],
                    "temperature": 0.7,
                    "top_p": 0.7,
                    "top_k": 50,
                    "frequency_penalty": 0.5,
                    "n": 1,
                    "response_format": {"type": "text"},
                }
                headers = {
                    "Authorization": "Bearer " + api_key,
                    "Content-Type": "application/json"
                }

                response = requests.post(url, json=payload, headers=headers, timeout=60)
                response.raise_for_status()
                response_json = response.json()

                if "R1" in select_model and "1.5B" not in select_model:
                    reasoning_content = response_json["choices"][0]["message"].get("reasoning_content", "")
                    print(f"\nthink:\n{reasoning_content}\n")
                    use_token = response_json.get("usage", {}).get("total_tokens", 0)
                    print(f"\n使用token数：{use_token}\n")
                return response_json['choices'][0]['message']['content']

            result = request_with_retry(call)
            if result is None:
                return "SiliconFlow 请求失败或超时"
            return result

        # NVIDIA 调用
        def nvidia():
            def call():
                api_key = api_keys['nvidia']['api_key']
                select_model = ("deepseek-ai/" + nvidia_model).lower()
                print("\n"+select_model)

                client = OpenAI(base_url="https://integrate.api.nvidia.com/v1", api_key=api_key)
                completion = client.chat.completions.create(
                    model=select_model,
                    messages=[{"role": "system", "content": system_prompt},{"role": "user", "content": user_prompt}],
                    temperature=0.6, top_p=0.7, max_tokens=8192, stream=False
                )

                response_data = completion.choices[0].message.content
                pattern = r'<think>(.*?)</think>'
                matches = re.findall(pattern, response_data, flags=re.DOTALL)
                if matches:
                    think_content = matches[0]
                    print(f"\nThink:\n{think_content}")
                else:
                    print("No <think>")

                use_token = completion.usage.total_tokens
                print(f"\n使用token数：{use_token}\n")
                answer_content = re.sub(pattern, '', response_data, flags=re.DOTALL).lstrip('\n')
                return answer_content

            result = request_with_retry(call)
            if result is None:
                return "NVIDIA 请求失败或超时"
            return result

        # 阿里云调用
        def aliyun():
            def call():
                api_key = api_keys['aliyun_bailian']['api_key']
                model_to_use = aliyun_model.replace('free-', '').lower()
                print("\n"+model_to_use)

                combined_prompt = system_prompt + "\n" + user_prompt
                client = OpenAI(base_url="https://dashscope.aliyuncs.com/compatible-mode/v1", api_key=api_key)
                completion = client.chat.completions.create(
                    model=model_to_use,
                    messages=[{"role": "user", "content": combined_prompt}],
                    stream=False
                )
                think_content = getattr(completion.choices[0].message, "reasoning_content", "")
                if think_content:
                    print(f"\nThink:\n{think_content}")
                answer_content = completion.choices[0].message.content
                return answer_content

            result = request_with_retry(call)
            if result is None:
                return "阿里云 请求失败或超时"
            return result

        # 根据选择模型返回结果
        if model == "siliconflow":
            return (True, siliconflow())
        elif model == "nvidia":
            return (True, nvidia())  
        elif model == "aliyun":
            return (True, aliyun())
        else:
            return (False, "不支持的模型类型")
            
    @classmethod
    def IS_CHANGED(cls):
        return True
